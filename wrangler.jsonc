{
  "observability": { "enabled": true },
  "name": "sidewise",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "sidewise.heyitsmejosh.com/*", "zone_id": "6cea109e1986f4a1ab47a94591961e19" },
    { "pattern": "news.heyitsmejosh.com/*", "zone_id": "6cea109e1986f4a1ab47a94591961e19" },
    { "pattern": "sidewise.jaybulb.com", "custom_domain": true },
    { "pattern": "news.jaybulb.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
